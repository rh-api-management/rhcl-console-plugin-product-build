# Stage 1: Build the static plugin assets (webpack bundle in ./dist)
FROM registry.redhat.io/ubi9/nodejs-22:latest AS builder

ARG YARNPKG_CLI=yarnpkg-cli-dist-4.12.0.tgz

USER root

# Install Yarn V4
WORKDIR /src/yarn

COPY yarn-install .

RUN if [[ -d /cachi2/output/deps/npm/ ]]; then \
      npm install -g /cachi2/output/deps/npm/"$YARNPKG_CLI"; \
      YARN_ENABLE_NETWORK=0; \
    else \
      npm install -g corepack; \
      corepack enable ;\
      corepack prepare yarn@4.12.0 --activate;  \
    fi

# Show node and yarn versions
RUN echo "Currently running node: $(node --version)" && \
    echo "Currently running yarn: $(yarn --version)"

WORKDIR /usr/src/app

# Copy license
COPY kuadrant-console-plugin/LICENSE /licenses/LICENSE
# Copy over the package.json/lock file only
COPY kuadrant-console-plugin/package.json kuadrant-console-plugin/yarn.lock ./
# Copy Yarn patch files referenced by the lockfile so `yarn install` can apply
# them (e.g. the patched @openshift-console/dynamic-plugin-sdk)
COPY kuadrant-console-plugin/.yarn/patches/ ./.yarn/patches/
# Use downstream .yarnrc.yml with s390x and ppc64le support
COPY .yarnrc.yml ./

# Skip native tree-sitter builds — this browser plugin uses the WASM fallback
# (web-tree-sitter) at runtime, and node-gyp cannot compile in hermetic mode
RUN node -e " \
  const pkg = JSON.parse(require('fs').readFileSync('package.json', 'utf8')); \
  pkg.dependenciesMeta = Object.assign(pkg.dependenciesMeta || {}, { \
    'tree-sitter': { built: false }, \
    'tree-sitter-json': { built: false }, \
    '@tree-sitter-grammars/tree-sitter-yaml': { built: false } \
  }); \
  require('fs').writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n');"

RUN yarn install

# Copy the rest of the contents from upstream repo to container
COPY kuadrant-console-plugin/ .

# Run downstream replacements script & production build
RUN yarn downstream-replacements
RUN yarn build

RUN test -f ./dist/plugin-manifest.json && \
    test -d ./dist/locales && \
    echo "All required files are present."

# Stage 2: Build the plugin-server (static asset server + MCP relay).
# The Go module has no external dependencies (standard library only, no go.sum),
# so the build is fully hermetic and needs no gomod prefetch.
FROM registry.redhat.io/ubi9/go-toolset:latest AS go-builder

USER root
WORKDIR /usr/src/app

COPY kuadrant-console-plugin/go.mod ./
COPY kuadrant-console-plugin/cmd/plugin-server ./cmd/plugin-server

# CGO_ENABLED=1 makes the RHEL go-toolset compiler back Go crypto with the
# certified OpenSSL module (FIPS-capable: uses FIPS crypto when the host is in
# FIPS mode, still runs on non-FIPS hosts). GOTOOLCHAIN=local + GOPROXY=off pin
# to the toolchain shipped in the image and keep the build hermetic.
ENV GOTOOLCHAIN=local GOPROXY=off CGO_ENABLED=1
RUN go build -trimpath -ldflags="-s -w" -o /plugin-server ./cmd/plugin-server

# Stage 3: Runtime image
FROM registry.redhat.io/ubi9/ubi-minimal:latest AS runner

# plugin-server is built with CGO_ENABLED=1 and dlopens libcrypto at runtime for
# the certified crypto module; ubi-minimal already ships openssl-libs, so no
# extra package install is needed.
RUN mkdir -p /usr/share/kuadrant-console-plugin && \
    chown -R root:0 /usr/share/kuadrant-console-plugin && \
    chmod -R g+rX /usr/share/kuadrant-console-plugin

COPY --from=builder /usr/src/app/dist/ /usr/share/kuadrant-console-plugin/
COPY --from=go-builder /plugin-server /usr/local/bin/plugin-server
COPY --from=builder /licenses/LICENSE /licenses/LICENSE

LABEL version="0.7.0" \
      com.redhat.component="rhcl-console-plugin-container" \
      name="rhcl-1/rhcl-console-plugin-rhel9" \
      cpe="cpe:/a:redhat:connectivity_link:1.5::el9" \
      summary="Red Hat Connectivity Link Console Plugin" \
      description="Console Plugin for Red Hat Connectivity Link" \
      io.k8s.display-name="Red Hat Connectivity Link Console Plugin" \
      io.openshift.tags="api" \
      io.k8s.description="" \
      maintainer="jmadigan@redhat.com"

USER 1001
ENTRYPOINT ["/usr/local/bin/plugin-server"]
